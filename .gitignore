# ========== CARPETAS DE DESARROLLO Y BUILD ==========
Pruebas/                # Área de experimentación (no sincronizar)
build/                  # Artefactos compilados
dist/                   # Salida de PyInstaller

# ========== COMPILACIÓN Y OBJETOS ==========
*.o                     # Objetos compilados (NASM)
*.so                    # Librerías compartidas
*.out                   # Ejecutables temporales

# ========== PYTHON ==========
*.pyc                   # Bytecode compilado
__pycache__/            # Cache de Python
*.pyo
*.egg-info/
*.egg
.Python
env/
venv/
ENV/

# ========== PYINSTALLER ==========
*.spec
build/
dist/

# ========== AUDIO PESADO ==========
/*.wav                  # Audio en raíz
assets/audio/*.wav      # Audios en assets/ (excepto si son commiteados intencionalmente)

# ========== DEBUG Y LOGS ==========
*.log
.vscode/*.log
.DS_Store
*~
*.swp
.gdb_history

# ========== ARTEFACTOS GENERADOS ==========
salida*.wav             # Audios generados por compilación
*.zip
*.tar.gz
